# Host port for the containerized Postgres — the single documented override
POSTGRES_PORT=5432
# Application connection string for the containerized Postgres
DATABASE_URL=postgresql://app:devpassword@localhost:5432/app_dev
# Mailpit SMTP capture — no auth, no TLS
SMTP_HOST=localhost
SMTP_PORT=1025
# Mailpit web UI and assertion API
MAILPIT_UI_PORT=8025
